800;margin-bottom:6px}\n.plan .who{color:var(--muted);font-size:14px;margin-bottom:16px}\n.plan ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:8px 22px}\n.plan li{padding-left:20px;position:relative;font-size:15px}\n.plan li::before{content:\"\";position:absolute;left:0;top:11px;width:9px;height:9px;background:var(--violet)}\n.plan .price{font-size:34px;font-weight:900}\n.plan .price small{font-size:15px;font-weight:600;color:var(--muted)}\n.plan .annual{font-size:13px;color:var(--violet-deep);font-weight:700}\n.plan.featured{background:#fff;box-shadow:10px 10px 0 var(--chip)}\n.plan.featured .side{background:var(--violet);color:#fff;border-left-color:var(--violet-deep)}\n.plan.featured .side .price small,.plan.featured .side .annual{color:#e9e2ff}\n\n/* 使用说明步骤 */\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.step .num{font-size:44px;font-weight:900;color:var(--violet);line-height:1;border-bottom:3px solid var(--line);padding-bottom:8px;margin-bottom:12px}\n.step h3{font-size:18px;font-weight:800;margin-bottom:6px}\n.step p{font-size:14.5px;color:var(--muted)}\n\n/* 客户端 */\n.clients{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}\n.client h3{font-size:19px;font-weight:800;margin-bottom:6px}\n.client p{font-size:14.5px;color:var(--muted)}\n.client .meta{margin-top:14px;font-size:13px;letter-spacing:.1em;color:var(--violet-deep);font-weight:700}\n\n/* FAQ details */\ndetails{background:#fff;border:3px solid var(--line);margin-bottom:14px}\nsummary{cursor:pointer;list-style:none;padding:18px 22px;font-weight:700;font-size:16.5px;display:flex;justify-content:space-between;align-items:center;gap:16px}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";font-size:24px;font-weight:900;color:var(--violet);flex:none}\ndetails[open] summary::after{content:\"−\"}\ndetails .ans{padding:0 22px 20px;color:var(--muted);font-size:15px;border-top:2px dashed #c9c9d6;margin:0 22px;padding:16px 0 20px}\ndetails[open] summary{color:var(--violet-deep)}\n\n/* 页尾 */\nfooter{margin-top:80px;border-top:3px solid var(--line);padding-top:24px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:var(--muted);font-size:13.5px}\nfooter b{color:var(--ink)}\n\n@media (max-width:900px){\n  .sidenav{width:56px}\n  .sidenav .logo{font-size:17px}\n  .sidenav nav a{font-size:12px}\n  main{margin-left:56px}\n  .tile.t1,.tile.t2,.tile.t3,.tile.t4,.tile.t5,.tile.t6{grid-column:span 6}\n  .plan{grid-template-columns:1fr}\n  .plan .side{border-left:none;border-top:3px solid var(--line)}\n  .steps{grid-template-columns:1fr}\n  .clients{grid-template-columns:1fr}\n  .plan ul{grid-template-columns:1fr}\n}\n@media (max-width:560px){\n  .dash{grid-template-columns:1fr 1fr}\n  .tile.t1,.tile.t2,.tile.t3,.tile.t4,.tile.t5,.tile.t6{grid-column:span 2}\n}\n</style><aside class=\"sidenav\">\n  <div class=\"logo\">DER</div>\n  <nav>\n    <a href=\"#hero\">首页</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#guide\">上手</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n  <div class=\"dot\"></div>\n</aside>\n\n<main>\n\n  \n  <section class=\"hero\" id=\"hero\">\n    <span class=\"hello\">朋友，先把话说清楚</span>\n    <h1>Der，把网络<br>交还给<em>日常</em>。</h1>\n    <p class=\"lede\">我们不讲玄乎的口号。流量多少、能连几台设备、每月多少钱，全都摊开在桌面上。你挑一档合适的，剩下的交给我们。</p>\n\n    <div class=\"dash\">\n      <div class=\"tile t1\">\n        <span class=\"k\">入门门槛</span>\n        <div class=\"v\">¥15 <span>/ 月起</span></div>\n        <span class=\"note\">基础版的价格，一杯奶茶都不到</span>\n      </div>\n      <div class=\"tile t2\">\n        <span class=\"k\">每月流量</span>\n        <div class=\"v\">100–1000 <span>GB</span></div>\n        <span class=\"note\">三档可选，按你的用量来</span>\n      </div>\n      <div class=\"tile t3\">\n        <span class=\"k\">同时在线设备</span>\n        <div class=\"v\">3–20 <span>台</span></div>\n        <span class=\"note\">手机、电脑、平板一起上</span>\n      </div>\n      <div class=\"tile t4\">\n        <span class=\"k\">套餐档位</span>\n        <div class=\"v\">3 <span>档</span></div>\n        <span class=\"note\">基础 / 旗舰 / 团队</span>\n      </div>\n      <div class=\"tile t5\">\n        <span class=\"k\">付费方式</span>\n        <div class=\"v\">月付 · 年付</div>\n        <span class=\"note\">年付更划算，每月省下一杯咖啡钱</span>\n      </div>\n      <div class=\"tile t6\">\n        <span class=\"k\">上手时间</span>\n        <div class=\"v\">≈ 3 <span>分钟</span></div>\n        <span class=\"note\">注册、导入、开启，三步搞定</span>\n      </div>\n    </div>\n\n    <div class=\"hero-cta\">\n      <a class=\"btn primary\" href=\"#plans\">看看三档套餐</a>\n      <a class=\"btn\" href=\"#guide\">三分钟上手指南</a>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\">\n    <h2>三档套餐，明码标价</h2>\n    <p class=\"sub\">没有隐藏条款，没有限速陷阱。下面写的，就是你拿到手的。</p>\n\n    <article class=\"plan card\">\n      <div class=\"body\">\n        <h3>基础版</h3>\n        <p class=\"who\">适合一个人轻度使用：刷刷资讯、看看视频、偶尔追个剧。</p>\n        <ul>\n          <li>每月 100GB 高速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体内容</li>\n          <li>普通线路节点池随意切换</li>\n        </ul>\n      </div>\n      <div class=\"side\">\n        <div class=\"price\">¥15 <small>/ 月</small></div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n        <a class=\"btn\" href=\"#\">选择基础版</a>\n      </div>\n    </article>\n\n    <article class=\"plan card featured\">\n      <span class=\"tag\">最多人选</span>\n      <div class=\"body\">\n        <h3>旗舰版</h3>\n        <p class=\"who\">适合重度用户和游戏玩家：流量管够，节点全开，还有人随时接应。</p>\n        <ul>\n          <li>每月 300GB 高速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </div>\n      <div class=\"side\">\n        <div class=\"price\">¥35 <small>/ 月</small></div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n        <a class=\"btn primary\" href=\"#\">选择旗舰版</a>\n      </div>\n    </article>\n\n    <article class=\"plan card\">\n      <div class=\"body\">\n        <h3>团队版</h3>\n        <p class=\"who\">适合小团队和公司：设备多、流量大，还有专人对接。</p>\n        <ul>\n          <li>每月 1000GB 高速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理一对一服务</li>\n        </ul>\n      </div>\n      <div class=\"side\">\n        <div class=\"price\">¥85 <small>/ 月</small></div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n        <a class=\"btn\" href=\"#\">选择团队版</a>\n      </div>\n    </article>\n  </section>\n\n  \n  <section id=\"guide\">\n    <h2>三分钟，从注册到上网</h2>\n    <p class=\"sub\">不用折腾，也不用看长篇教程。跟着这三步走就行。</p>\n    <div class=\"steps\">\n      <div class=\"step card\">\n        <div class=\"num\">01</div>\n        <h3>注册并挑一档套餐</h3>\n        <p>用邮箱注册账号，根据你的设备数量和每月用量，从基础、旗舰、团队三档里选一个。拿不准就先选基础版，之后随时可以升级。</p>\n      </div>\n      <div class=\"step card\">\n        <div class=\"num\">02</div>\n        <h3>把订阅导入客户端</h3>\n        <p>登录后台复制你的专属订阅链接，粘贴进你常用的客户端。节点列表会自动同步进来，不用手动一个个添加。</p>\n      </div>\n      <div class=\"step card\">\n        <div class=\"num\">03</div>\n        <h3>选个节点，开启</h3>\n        <p>从节点列表里挑一个延迟低的，点下开关。看视频选流媒体节点，打游戏选专线节点，就这么简单。</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\">\n    <h2>客户端怎么装</h2>\n    <p class=\"sub\">Der 通过标准订阅链接工作，你设备上常用的客户端基本都能直接用。</p>\n    <div class=\"clients\">\n      <div class=\"client card\">\n        <h3>手机端</h3>\n        <p>iPhone 和安卓手机都有对应的主流客户端可用。在应用商店搜索你熟悉的客户端名称，安装后导入订阅链接即可。具体下载地址以各应用商店页面为准。</p>\n        <div class=\"meta\">iOS · ANDROID</div>\n      </div>\n      <div class=\"client card\">\n        <h3>电脑端</h3>\n        <p>Windows 和 macOS 上常用的桌面客户端都支持订阅导入。安装好客户端后，把后台的订阅链接粘贴进去，节点就会自动出现。</p>\n        <div class=\"meta\">WINDOWS · MACOS</div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <h2>你可能想问</h2>\n    <p class=\"sub\">买之前把疑问都解开，才花得安心。</p>\n\n    <details>\n      <summary>流量用超了会怎么样？</summary>\n      <div class=\"ans\">当月流量用完后，服务会暂停到下一个计费周期自动恢复，不会产生任何额外费用。如果你经常不够用，建议直接升到旗舰版，300GB 对大多数人来说都很宽裕。</div>\n    </details>\n\n    <details>\n      <summary>可以先月付试试，之后再改年付吗？</summary>\n      <div class=\"ans\">当然可以。很多朋友都是先月付体验一两个周期，觉得顺手了再改成年付。年付相当于约十个月的价格用一年，长期用更划算。</div>\n    </details>\n\n    <details>\n      <summary>套餐中途能升级或降级吗？</summary>\n      <div class=\"ans\">可以。在后台随时切换套餐档位，升级后立即生效，降级则在当前计费周期结束后生效。团队版用户如需调整，直接联系你的专属客户经理就行。</div>\n    </details>\n\n    <details>\n      <summary>设备数量是怎么算的？</summary>\n      <div class=\"ans\">按\"同时在线\"计算，不是按绑定数量。比如基础版支持 3 台同时在线，你可以在更多设备上登录，只要同一时刻在线的不超过 3 台就没问题。</div>\n    </details>\n\n    <details>\n      <summary>打游戏应该选哪个套餐？</summary>\n      <div class=\"ans\">推荐旗舰版。它包含 IPLC 专线游戏加速优化，延迟表现更稳定，而且 300GB 流量足够日常游戏加影音一起用。如果只是偶尔玩两把，基础版也能应付。</div>\n    </details>\n\n    <details>\n      <summary>遇到问题找谁？</summary>\n      <div class=\"ans\">在后台提交工单就好。旗舰版用户享有 7×24 优先工单支持，响应更快；团队版用户则有专属客户经理，直接对接，不用排队。</div>\n    </details>\n  </section>\n\n  <footer>\n    <div><b>Der</b> — 把网络交还给日常。</div>\n    <div>价格与权益以页面公示为准 · 订阅前请确认你的使用需求</div>\n  </footer>\n\n</main>",
